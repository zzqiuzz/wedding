{
    "version": 2,
    "name": "wedding-website",
    "builds": [
        { "src": "**/*", "use": "@vercel/static" }
    ],
    "routes": [
        { "src": "/(.*)", "dest": "/$1" }
    ],
    "env": {
        "SUPABASE_URL": "@supabase_url",
        "SUPABASE_ANON_KEY": "@supabase_anon_key",
        "AMAP_API_KEY": "@amap_api_key"
    }
}
